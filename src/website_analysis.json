        "lead":        { "size": "19px", "lineHeight": "28.5px", "weight": 500 },
        "label":       { "size": "18px", "lineHeight": "27px", "weight": 500 },
        "input":       { "size": "27px", "lineHeight": "normal", "weight": 400 },
        "body":        { "size": "16px", "lineHeight": "24px", "weight": 400 },
        "bodySmall":   { "size": "15px", "lineHeight": "22.5px", "weight": 400 },
        "caption":     { "size": "13px", "lineHeight": "19.5px", "weight": 400 }
      },
      "letterSpacing": { "default": "normal" }
    },
    "spacing": {
      "tokens": {
        "0": "0px", "1": "4px", "2": "8px", "3": "10px", "4": "12px", "5": "14px",
