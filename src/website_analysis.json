      "default": "1px solid #e8e8e8",
      "subtle": "1px solid #e3e3e3",
      "strong": "1px solid #262626",
      "brand": "1px solid #ff7d12",
      "categoryHover": "1px solid #f27824"
    },
    "transitions": {
      "fast": "all 0.2s ease-in-out",
      "base": "all 0.3s ease-in-out",
      "slow": "all 0.5s ease-in-out",
      "lazy": "all 0.8s ease-in-out",
      "transform": "transform 0.3s"
    },
    "zIndex": {
      "headerFixed": 2000,
      "overlay": 1000,
      "modal": 3000,
      "toast": 4000
    },
    "breakpoints": { "desktop": "1080px", "wide": "1320px" }
  },

  "layouts": [
    {
      "id": "appShell",
      "structure": ["FixedHeader", "ContentWrap", "Footer"],
      "headerPosition": "fixed",
      "headerHeight": 68,
      "contentTopOffset": 68,
      "innerContainer": { "maxWidth": 1320, "align": "center", "justify": "center" }
    },
    {
      "id": "section",
      "pattern": "flex row justify-center, child .inner (1320px) inside",
      "paddingY": "90px",
      "variants": [
        { "name": "default", "bg": "#ffffff" },
        { "name": "gray", "bg": "#f9f9f9" },
        { "name": "gradient", "bg": "linear-gradient(91deg, rgba(255,125,18,0.05) 0%, rgba(255,197,58,0.05) 29%, rgba(65,216,158,0.05) 64%, rgba(49,208,244,0.05) 100%)" },
        { "name": "topHero", "bg": "linear-gradient(to right, #fff5ec 0%, #fff5ec 33%, #eafbfe 100%)", "padding": "70px 0px 50px" }
      ]
    },
    {
      "id": "sectionHeader",
      "selector": ".contentsTitle",
      "pattern": "flex row, justify-content: space-between, align-items: center",
      "children": ["h2 (title, 30px/700)", "a (전체보기 / 더보기 with chevron svg)"]
    },
    {
      "id": "statSplit",
      "selector": ".mainContentsTopCard",
      "pattern": "flex row, two columns ~650px each",
      "columns": [
        { "name": "mainContentsCardLeft", "stack": ["NumberStat (누적 프로젝트 금액)", "NumberStat (포트폴리오 수)"] },
        { "name": "card3", "padding": "30px 40px", "radius": "10px", "stack": ["title", "value", "description", "CTA arrow link"] }
      ]
    },
    {
      "id": "estimateGrid",
      "selector": ".estimateCardWrap",
      "pattern": "2-column grid via flex",
      "cellSize": { "w": 650, "h": 223 },
      "rowHeight": 494,
      "tabFilter": ".estimateFilter (flex row, space-between)"
    },
    {
      "id": "cardCarouselRow",
      "appliesTo": ["partner", "portfolio", "review"],
      "pattern": "horizontal scroll/swipe row of fixed-width cards with right margin",
      "marginRight": "16px–18px"
    },
    {
      "id": "processTimeline",
      "selector": ".processBar",
      "pattern": "horizontal 6-step bar above active step detail card",
      "structure": ["bar (1px #e8e8e8)", "stepWrap (6× .step, one .step.on)", ".process detail (1320px, 40px 60px padding, 10px radius, 1px solid #e8e8e8)"]
    },
    {
      "id": "footerRows",
      "pattern": "two stacked rows (.footerWrap, .footerBotWrap) inside centered footer",
      "footerHeight": 268,
      "borderTop": "1px solid #e8e8e8"
    }
  ],

  "components": [
    {
      "id": "Navbar",
      "type": "Navbar",
      "name": "GlobalHeader",
      "reusable": true,
      "selector": "#header_new",
      "structure": {
        "root": { "tag": "header", "position": "fixed", "top": 0, "zIndex": 2000, "width": "100%", "height": "68px", "bg": "#ffffff", "borderBottom": "1px solid #e8e8e8", "display": "flex", "justify": "center", "align": "center" },
        "inner": { "selector": ".headerWrap", "maxWidth": 1080, "display": "flex", "justify": "space-between", "align": "center", "height": 67 },
        "left": { "selector": ".headerLeft", "display": "flex", "align": "center", "children": ["Logo (img src=/public/images/freemoa-logo-none.svg, 90×17)", "NavLink × N"] },
        "right": { "selector": ".headerRight", "display": "flex", "align": "center", "children": ["AuthLink (로그인)", "Divider |", "AuthLink (회원가입)", "PrimaryPillCTA (무료 견적 의뢰)"] }
      },
      "styles": {
        "navLink": { "color": "#666666", "fontSize": "16px", "fontWeight": 400, "transition": "all 0.3s ease-in-out" },
        "primaryCta": { "selector": ".requestBtn_new", "bg": "#fe7c25", "color": "#ffffff", "radius": "100px", "width": "110px", "height": "36px", "fontSize": "16px", "display": "flex", "justify": "center", "align": "center", "transition": "all 0.5s ease-in-out" }
      },
      "states": {
        "primaryCta": { "hover": { "boxShadow": "rgba(0,0,0,0.2) 2px 2px 4px" } },
        "moreToggle": { "selector": ".moreViewBtn", "default": { "fontSize": "18px", "color": "#555555" }, "open": { "label": "접기" }, "closed": { "label": "더보기" } }
      },
      "children": ["Logo", "NavLink", "MoreToggle", "AuthLinks", "PrimaryPillButton"],
      "items": [
        { "label": "프로젝트", "href": "/m4/s41" },
        { "label": "파트너스", "href": "/m7/s71" },
        { "label": "포트폴리오 검색", "href": "/m7/s712" },
        { "label": "이용후기", "href": "/review/reviewList" },
        { "label": "이용방법", "href": "/m1/guide?tab=guide_client", "inMore": true },
        { "label": "블로그", "href": "https://blog.naver.com/freemoa1", "external": true, "inMore": true },
        { "label": "예상견적 조회", "href": "/search", "inMore": true },
        { "label": "프리미엄 PRO", "href": "https://pro.freemoa.net", "external": true, "inMore": true },
        { "label": "개발자 채용", "href": "/teamdev", "inMore": true },
        { "label": "유지보수", "href": "/management", "inMore": true }
      ]
    },
    {
      "id": "Hero",
      "type": "Hero",
      "name": "MainHero",
      "reusable": false,
      "selector": ".mainContentsTop",
      "structure": {
        "root": { "width": 1425, "height": 920, "padding": "70px 0px 50px", "display": "flex", "justify": "center", "bg": "#ffffff", "bgImage": "linear-gradient(rgba(255,255,255,0) 85%, #fff 100%), linear-gradient(to right, #fff5ec 0%, #fff5ec 33%, #eafbfe 100%)" },
        "inner": { "selector": ".inner", "width": 1425, "height": 800 },
        "title": { "selector": ".mainTitle .title", "tag": "h3", "height": 160, "margin": "114px 0px 50px", "composition": "span (당신이 찾는) + RollingText (rotating phrase)" },
        "rotatingText": { "selector": ".rolling_text", "fontSize": "58px", "lineHeight": "57px", "fontWeight": 400, "color": "#262626", "phrases": ["프리랜서 개발자","프리랜서 디자이너","프리랜서 기획자","업무시스템 개발업체","웹서비스 개발업체","모바일앱 개발업체","AI 개발업체","플랫폼 개발업체","해외 개발업체"] },
        "tagSpan": { "selector": ".mainTitle h3 > span", "fontSize": "59px", "lineHeight": "60px", "fontWeight": 300 },
        "marqueeAbove": { "selector": ".cycle-slideshow.cycle-autoinit:first-of-type", "width": 1425, "height": 60, "type": "horizontal-marquee", "slides": 61 },
        "marqueeBelow": { "selector": ".cycle-slideshow.cycle-autoinit:nth-of-type(2)", "width": 1425, "height": 60, "type": "horizontal-marquee", "slides": 61 },
        "searchPanel": { "selector": ".mainSearchWrap", "width": 1120, "height": 212, "padding": "35px 40px 30px", "radius": "20px", "display": "flex", "align": "center", "children": ["MainSearch", "OrBar", "MainLink"] },
        "mainSearch": { "selector": ".mainSearch", "width": 740, "height": 147, "children": ["Input (size 27px, h=82px)", "Suggestion chips (오픈마켓, 반려동물, 병원예약, O2O/중개, 배달, 교육, 헬스케어)"] },
        "orBar": { "selector": ".mainOrBar", "width": 29, "label": "또는" },
        "mainLink": { "selector": ".mainLink", "width": 201, "links": [ {"label": "무료 견적 의뢰", "href": "/m4/regProject"}, {"label": "간편 견적 조회", "href": "/search"} ] }
      },
      "interactions": ["rotating-text (jQuery cycle plugin)", "marquee scrollers (jQuery cycle)", "search autocomplete suggestions"]
    },
    {
      "id": "StatPanel",
      "type": "Section",
      "name": "StatPanel",
      "reusable": false,
      "selector": ".mainContentsTopCard",
      "structure": {
        "layout": "flex row, gap implicit, two columns",
        "left": {
          "selector": ".mainContentsCardLeft",
          "children": [
            { "type": "NumberStat", "label": "누적 프로젝트 금액", "value": "424,363,430,000", "unit": "원" },
            { "type": "NumberStat", "label": "포트폴리오 수", "value": "92,489", "unit": "건" }
          ]
        },
        "right": {
          "selector": ".card3",
          "padding": "30px 40px",
          "radius": "10px",
          "children": [
            { "type": "NumberStat", "label": "진행중 프로젝트 수", "value": "101", "unit": "건" },
            { "type": "Paragraph", "text": "현재 프리모아를 통해 진행중인 기획, 디자인, 개발을 포함한 IT 프로젝트입니다." },
            { "type": "ArrowLink", "label": "프로젝트 보러가기", "selector": ".cardBtn" }
          ]
        }
      }
    },
    {
      "id": "NumberStat",
      "type": "Card",
      "name": "NumberStat",
      "reusable": true,
      "structure": { "children": ["label (h2)", "value (large number)", "unit (small)"] },
      "styles": { "label": { "fontSize": "21px", "fontWeight": 600 }, "value": { "fontSize": "46px", "fontWeight": 700, "color": "#262626" }, "unit": { "fontSize": "17px", "color": "#555555" } }
    },
    {
      "id": "EstimateSection",
      "type": "Section",
      "name": "ActiveBidsSection",
      "reusable": false,
      "selector": ".mainContents:nth-of-type(3)",
      "structure": {
        "title": "진행중인 비교견적",
        "actions": ["MoreLink (더보기)"],
        "tabs": { "selector": ".estimateFilter", "items": ["어플리케이션 개발","웹 개발","소프트웨어 개발","게임 개발","기획&디자인","영상제작","퍼블리싱","기타"], "activeClass": "on" },
        "grid": { "selector": ".estimateCardWrap", "columns": 2, "cardWidth": 650, "cardHeight": 223 }
      }
    },
    {
      "id": "EstimateCard",
      "type": "Card",
      "name": "EstimateCard",
      "reusable": true,
      "selector": ".estimateCard.hrefCard",
      "structure": { "width": 650, "height": 223, "display": "block" },
      "variants": [{ "name": "hrefCard", "description": "Whole card is a link surface" }]
    },
    {
      "id": "PartnerSection",
      "type": "Section",
      "name": "PartnerSection",
      "reusable": true,
      "selector": ".mainContentsGray",
      "structure": {
        "title": ["개발/디자인 업체", "프리랜서"],
        "categoryTabs": ["개발", "디자인", "기획"],
        "cards": "Row of .partnerCard"
      },
      "styles": { "background": "#f9f9f9" }
    },
    {
      "id": "PartnerCard",
      "type": "Card",
      "name": "PartnerCard",
      "reusable": true,
      "selector": ".partnerCard",
      "structure": {
        "root": { "width": "258px", "height": "301px", "bg": "#ffffff", "radius": "10px", "padding": "25px", "marginRight": "16px" },
        "children": [
          { "selector": ".profileWrap", "children": [
            { "selector": ".profile", "size": "80×80", "radius": "100px", "children": ["img (78×78)", "videoPlay overlay (25×32)"] }
          ] },
          { "selector": ".name", "children": [ { "tag": "p", "fontWeight": 600, "text": "id (masked)" }, { "selector": ".type", "color": "#aaaaaa", "text": "type (개인프리랜서)" } ] },
          { "selector": ".category", "children": [ { "selector": "b.a (개발 badge)", "bg": "#edfafd", "color": "#31d0f4", "radius": "100px", "fontSize": "17px", "padding": "0px 10px" } ] },
          { "selector": ".tech", "color": "#aaaaaa", "fontSize": "16px", "text": "comma-separated skill list" },
          { "selector": ".info", "children": [
            { "selector": ".starRating", "children": ["starRating_new (96×15 sprite)", "b (rating value 16px/600)"] },
            { "tag": "p", "fontSize": "15px", "text": "계약 : N건" }
          ] }
        ]
      },
      "variants": [
        { "name": "category-dev", "badge": { "bg": "#edfafd", "fg": "#31d0f4" } },
        { "name": "category-design", "badge": { "bg": "#effaf6", "fg": "#41d89e" } },
        { "name": "category-plan", "badge": { "bg": "#fdf2e9", "fg": "#ff7d12" } }
      ]
    },
    {
      "id": "PortfolioSection",
      "type": "Section",
      "name": "PortfolioSection",
      "reusable": false,
      "selector": ".mainContents:nth-of-type(6)",
      "structure": { "title": "등록된 포트폴리오로 파트너 찾기", "action": "전체보기", "list": "row of .portfolioCard" }
    },
    {
      "id": "PortfolioCard",
      "type": "Card",
      "name": "PortfolioCard",
      "reusable": true,
      "selector": ".portfolioCard",
      "structure": {
        "root": { "width": "305px", "height": "243px", "marginRight": "16px" },
        "children": [
          { "selector": ".imgWrap", "width": "305px", "height": "204px", "radius": "10px", "overflow": "hidden", "marginBottom": "12px", "children": [ { "tag": "img" } ] },
          { "selector": "h2.title", "fontSize": "18px", "padding": "0px 5px", "lineClamp": 1 }
        ]
      },
      "states": {
        "imageHover": { "selector": ".portfolioCard .imgWrap > img:hover", "transform": "scale(1.1)", "transition": "transform 0.3s" }
      }
    },
    {
      "id": "ReviewSection",
      "type": "Section",
      "name": "ReviewSection",
      "reusable": false,
