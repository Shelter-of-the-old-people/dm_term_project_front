        "12": "30px", "14": "40px", "16": "50px", "18": "60px", "22": "70px", "26": "90px", "30": "120px"
      },
      "sectionPaddingY": "90px",
      "sectionInnerMaxWidth": "1320px",
      "headerInnerMaxWidth": "1080px",
      "headerHeight": "68px",
      "footerHeight": "268px",
      "commonPaddings": ["0px 10px", "0px 20px", "20px 20px 0px", "8px 12px 7px", "40px 60px", "30px 40px", "15px 25px 25px", "25px 25px 20px", "35px 40px 30px"]
    },
    "radius": {
      "none": "0px",
      "xs": "3px",
      "sm": "5px",
      "md": "10px",
      "lg": "20px",
      "pill": "100px",
      "pillLarge": "47px",
      "circle": "50%"
