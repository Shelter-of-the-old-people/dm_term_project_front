        "highContrast": "#2c2c2c"
      },
      "brand": {
        "primary": "#ff7d12",
        "primarySolid": "#fe7c25",
        "accentCyan": "#31d0f4",
        "accentGreen": "#41d89e",
        "accentYellow": "#ffc53a"
      },
      "surface": {
        "page": "#ffffff",
        "subtle": "#f9f9f9",
        "neutral": "#f2f2f2",
        "divider": "#e8e8e8",
        "border": "#e3e3e3",
        "outline": "#707070",
        "soft": "#f0f0f0",
